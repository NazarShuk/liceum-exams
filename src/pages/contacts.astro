---
import Layout from "@layouts/Layout.astro";
import { contacts } from "@lib/contacts";
---

<Layout title="Контакти">
    <section>
        <h1>Контакти</h1>
        <p class="mt-4 max-w-2xl text-black/65">
            Зв’яжіться з нами, якщо маєте питання щодо вступу або роботи порталу.
        </p>

        <ul class="mt-10 grid gap-5 sm:grid-cols-2">
            {contacts.map((contact) => (
                <li class="card flex gap-4 bg-card">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-diia-bright-grey text-liceum-blue">
                        <span class="material-symbols-outlined text-[22px]" aria-hidden="true">
                            {contact.icon}
                        </span>
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm text-black/60">{contact.label}</p>
                        {contact.href ? (
                            <a
                                href={contact.href}
                                class="mt-1 block wrap-break-word transition-colors hover:text-liceum-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-liceum-blue"
                            >
                                {contact.value}
                            </a>
                        ) : (
                            <p class="mt-1 wrap-break-word">{contact.value}</p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    </section>
</Layout>
