---
import { actions } from "astro:actions";
import Layout from "../layouts/Layout.astro";

const result = Astro.getActionResult(actions.logout);
if (result && !result.error){
  return Astro.redirect("/");
}
---

<Layout>
    <h1>Привіт, {Astro.locals.user.firstName}</h1>
    <div class="w-full flex flex-row justify-between">
        <a data-astro class="cursor-pointer" href="/cabinet/register">Реєстрація</a>
        <a class="cursor-pointer" href="/cabinet/news">Новини</a>
        <a class="cursor-pointer" href="/cabinet/account">Аккаунт</a>
    </div>
    <form action={actions.logout} method="POST">
        <button class="btn-default">Вийти</button>
    </form>
</Layout>