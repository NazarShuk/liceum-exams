---
import Layout from '@layouts/Layout.astro';
import { logErrorEvent } from '@lib/analytics';

interface Props {
  error: unknown;
}

const { error } = Astro.props;

logErrorEvent({
  source: "server",
  type: "page_error",
  path: Astro.url.pathname,
  message: error instanceof Error ? error.message : String(error),
  userId: Astro.locals.user?.id,
});

---

<Layout className="flex h-screen justify-center items-center flex-col">
    <h1 class="mb-5">Помилка :(</h1>
    <p class="text-diia-red mb-5">{error}</p>
    <a class="btn-default mt-5" href="/">Повернутися на головну</a>

</Layout>