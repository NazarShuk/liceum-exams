---
import GoogleSignIn from "@components/GoogleSignIn.astro";
import Layout from "@layouts/Layout.astro";
import { format } from "date-fns";
import { uk } from "date-fns/locale";
import LiceumLogo from "../assets/LiceumLogo.svg";
import { getDrizzle } from "@db/drizzle";
import { markdownExcerpt } from "../lib/markdown";

if (Astro.locals.user) {
  return Astro.redirect("/cabinet");
}

const contacts = [
  {
    icon: "location_on",
    label: "Адреса",
    value: "вул. Чуднівська, 103, м. Житомир 10005",
    href: null
  },
  {
    icon: "call",
    label: "Телефон",
    value: "+380509856415",
    href: "tel:+380509856415"
  },
  {
    icon: "mail",
    label: "Електронна пошта",
    value: "liceum@ztu.edu.ua",
    href: "mailto:liceum@ztu.edu.ua"
  }
];

const db = getDrizzle()
const news = await db.query.news.findMany({
  limit: 3,
  orderBy: {
    createdAt: "desc"
  }
})
---

<Layout noPadding={true}>
    <section
      class="relative isolate flex min-h-[calc(100svh-0.5rem)] items-center overflow-hidden px-5 py-16 sm:px-8 lg:px-12"
      aria-labelledby="hero-heading"
    >
      <div class="hero-aurora" aria-hidden="true">
        <span class="hero-blob hero-blob--orange"></span>
        <span class="hero-blob hero-blob--green"></span>
        <span class="hero-blob hero-blob--red"></span>
        <span class="hero-blob hero-blob--blue"></span>
        <span class="hero-blob hero-blob--grey"></span>
      </div>
      <div class="hero-fade" aria-hidden="true"></div>

      <div class="relative mx-auto w-full max-w-6xl">
        <div class="max-w-2xl min-w-0">
          <LiceumLogo width={256} class="mb-6" />
          <h1 id="hero-heading" class="hero-title text-balance">
            Єдиний портал вступу до ліцею
          </h1>

          <p class="mt-6 max-w-xl text-[17px]/[26px] text-black/65 sm:text-[19px]/[30px]">
            Подайте заяву, слідкуйте за статусом і отримуйте результати вступних випробувань в одному кабінеті.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <GoogleSignIn />
            <a
              href="#news"
              class="inline-flex items-center transition-colors hover:text-liceum-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-liceum-blue"
            >
              Новини
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="news" class="px-5 py-20 sm:px-8 lg:px-12" aria-labelledby="news-heading">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-5 border-b border-diia-bright-grey pb-8">
          <h2 id="news-heading">Новини</h2>
          <a
            href="/news"
            class="inline-flex items-center transition-colors hover:text-liceum-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-liceum-blue"
          >
            Усі новини {"->"}
          </a>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {news.map((item) => (
            <article class="card bg-[#FFFFFF]">
              <a class="flex flex-col gap-4" href={`/news/${item.id}`}>
                <div class="flex items-center justify-between gap-3">
                  <span class="rounded-full bg-diia-bright-grey px-3 py-1 text-sm text-liceum-blue">
                    {item.tag}
                  </span>
                  <time datetime={new Date(item.createdAt).toISOString()} class="text-sm text-black/60">
                    {format(new Date(item.createdAt), "d MMMM yyyy", { locale: uk })}
                  </time>
                </div>
                <h3 class="news-card-title">{item.title}</h3>
                <p class="text-black/65">{markdownExcerpt(item.content, 120)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contacts" class="px-5 pb-24 pt-4 sm:px-8 lg:px-12" aria-labelledby="contacts-heading">
      <div class="mx-auto max-w-6xl">
        <div class="card grid gap-10 bg-[#FFFFFF] lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <h2 id="contacts-heading">Контакти</h2>

          <ul class="grid gap-6 sm:grid-cols-2">
            {contacts.map((contact) => (
              <li class="flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-diia-bright-grey text-liceum-blue">
                  <span class="material-symbols-outlined text-[22px]" aria-hidden="true">{contact.icon}</span>
                </span>
                <div class="min-w-0">
                  <p class="text-sm text-black/60">{contact.label}</p>
                  {contact.href ? (
                    <a
                      href={contact.href}
                      class="mt-1 block break-words transition-colors hover:text-liceum-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-liceum-blue"
                    >
                      {contact.value}
                    </a>
                  ) : (
                    <p class="mt-1 break-words">{contact.value}</p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
</Layout>

<style>
  .hero-title {
    font-size: 2.5rem;
    line-height: 2.75rem;
  }

  .news-card-title {
    font-size: 1.375rem;
    line-height: 1.75rem;
  }

  @media (min-width: 40rem) {
    .hero-title {
      font-size: 3.25rem;
      line-height: 3.625rem;
    }
  }

  @media (min-width: 64rem) {
    .hero-title {
      font-size: 4rem;
      line-height: 4.25rem;
    }
  }

  .hero-aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 8% 12%, rgba(239, 95, 1, 0.2), transparent 62%),
      radial-gradient(70% 65% at 92% 8%, rgba(85, 171, 3, 0.18), transparent 58%),
      radial-gradient(70% 70% at 82% 92%, rgba(222, 36, 5, 0.13), transparent 62%),
      radial-gradient(75% 70% at 4% 88%, rgba(35, 74, 153, 0.17), transparent 62%),
      linear-gradient(120deg, #fbfaf5 0%, #f5f7f3 45%, #f4f4f5 100%);
    background-size: 150% 150%;
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.45;
    will-change: transform;
  }

  .hero-blob--orange {
    top: -12rem;
    left: -8rem;
    width: 30rem;
    height: 30rem;
    background: radial-gradient(circle, rgba(239, 95, 1, 0.55) 0%, rgba(239, 95, 1, 0) 70%);
    animation: hero-drift-a 22s ease-in-out infinite;
  }

  .hero-blob--green {
    top: 6%;
    right: -9rem;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle, rgba(85, 171, 3, 0.5) 0%, rgba(85, 171, 3, 0) 70%);
    animation: hero-drift-b 28s ease-in-out infinite;
  }

  .hero-blob--red {
    bottom: -10rem;
    left: 38%;
    width: 24rem;
    height: 24rem;
    background: radial-gradient(circle, rgba(222, 36, 5, 0.4) 0%, rgba(222, 36, 5, 0) 70%);
    animation: hero-drift-c 24s ease-in-out infinite;
  }

  .hero-blob--blue {
    bottom: -8rem;
    left: -6rem;
    width: 28rem;
    height: 28rem;
    background: radial-gradient(circle, rgba(35, 74, 153, 0.45) 0%, rgba(35, 74, 153, 0) 70%);
    animation: hero-drift-d 30s ease-in-out infinite;
  }

  .hero-blob--grey {
    top: 35%;
    left: 45%;
    width: 34rem;
    height: 34rem;
    opacity: 0.3;
    background: radial-gradient(circle, rgba(169, 173, 182, 0.5) 0%, rgba(169, 173, 182, 0) 70%);
    animation: hero-drift-e 34s ease-in-out infinite;
  }

  .hero-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 9rem;
    background: linear-gradient(to bottom, rgba(244, 244, 245, 0), #f4f4f5);
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .hero-blob {
      filter: blur(50px);
    }

    .hero-blob--grey {
      display: none;
    }
  }

  @keyframes aurora-drift {
    0% {
      background-position: 0% 0%;
    }
    50% {
      background-position: 80% 60%;
    }
    100% {
      background-position: 20% 100%;
    }
  }

  @keyframes hero-drift-a {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    33% {
      transform: translate3d(12%, 6%, 0) scale(1.12);
    }
    66% {
      transform: translate3d(4%, 18%, 0) scale(0.94);
    }
  }

  @keyframes hero-drift-b {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    40% {
      transform: translate3d(-10%, 14%, 0) scale(1.08);
    }
    75% {
      transform: translate3d(-2%, -8%, 0) scale(0.92);
    }
  }

  @keyframes hero-drift-c {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    35% {
      transform: translate3d(-8%, -12%, 0) scale(1.1);
    }
    70% {
      transform: translate3d(10%, -4%, 0) scale(0.96);
    }
  }

  @keyframes hero-drift-d {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    45% {
      transform: translate3d(14%, -10%, 0) scale(1.14);
    }
    80% {
      transform: translate3d(4%, 6%, 0) scale(0.95);
    }
  }

  @keyframes hero-drift-e {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-12%, 10%, 0) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-aurora,
    .hero-blob {
      animation: none !important;
    }
  }
</style>
