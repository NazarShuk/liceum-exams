---
import { getDrizzle } from "@db/drizzle";
import Layout from "@layouts/Layout.astro";

const db = getDrizzle();
const user = Astro.locals.user;
const allGroups = await db.query.groups.findMany({
    with: {
        teachers: { columns: { id: true, firstName: true, lastName: true } },
        applications: { columns: { id: true } },
    },
    orderBy: { title: "asc" },
});
const groups =
    user.role === "admin"
        ? allGroups
        : allGroups.filter((group) => group.teachers.some((teacher) => teacher.id === user.id));
---

<Layout title="Групи">
    <h1>Групи</h1>
    {groups.length === 0 && <p class="mt-5">Груп поки що немає.</p>}
    <ul class="mt-5 list-colors">
        {groups.map((group) => (
            <li>
                <a href={`/admin/groups/${group.id}`}>
                    <div class="card mb-5">
                        <h4>{group.title}</h4>
                        <p>{group.applications.length} заяв</p>
                        <p class="text-sm text-black/60">
                            {group.teachers.map((teacher) => `${teacher.firstName} ${teacher.lastName}`).join(", ")}
                        </p>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</Layout>
