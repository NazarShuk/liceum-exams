---
import { getDrizzle } from "@db/drizzle";
import Layout from "@layouts/Layout.astro";
import ApplicationsTable from "@components/ApplicationsTable.svelte";
import GroupEditor from "@components/GroupEditor.svelte";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const db = getDrizzle();
const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const groupId = Number(Astro.params.id);
const group = Number.isInteger(groupId)
    ? await db.query.groups.findFirst({
          where: { id: groupId },
          with: {
              teachers: true,
              applications: { with: { student: true, user: true } },
          },
      })
    : undefined;

if (!group || (user.role !== "admin" && !group.teachers.some((teacher) => teacher.id === user.id))) {
    return Astro.redirect(localizePath(locale, "/admin/groups"));
}

const campaigns = await db.query.campaigns.findMany({
    with: {
        profiles: {
            with: { form: true },
        },
    },
});
const teachers =
    user.role === "admin"
        ? await db.query.users.findMany({
              where: { role: "teacher" },
              orderBy: { lastName: "asc" },
          })
        : [];
---

<Layout title={group.title}>
    <a href={localizePath(locale, "/admin/groups")}>
        {"<-"} {t("admin.groups.all")}
    </a>
    <h1>{group.title}</h1>
    {user.role === "admin" && <GroupEditor group={group} teachers={teachers} {locale} client:load />}
    {campaigns.length > 0 ? (
        <ApplicationsTable
            applications={group.applications}
            campaigns={campaigns}
            allowDelete={false}
            allowGroupRemove={user.role === "admin"}
            allowStatusEdit={user.role === "admin"}
            allProfiles
            groupId={group.id}
            {locale}
            client:load
        />
    ) : (
        <p>{t("admin.noCampaigns")}</p>
    )}
</Layout>
