---
import Layout from "@layouts/Layout.astro";
import AdminSidebar from "@layouts/AdminSidebar.astro"
import { getDrizzle } from "@db/drizzle";
import {formatRelative, isBefore} from "date-fns"
import {uk} from "date-fns/locale"

const db = getDrizzle()
const campaigns = await db.query.campaigns.findMany()
---

<Layout>
    <AdminSidebar slot={"left-side"} />
    <h1>Кампанії</h1>
    <a href="campaigns/editor">+ Створити кампанію</a>
    <ul>
        {campaigns.map(campaign => (
            <a href={`campaigns/editor?campaign=${campaign.id}`}>
                <li class="h-24 border p-1">
                    <div class="w-full flex flex-row justify-between">
                        <p>{campaign.title}</p>
                        {isBefore(new Date(), campaign.beginsAt || 0) && <p>Почнеться {formatRelative(campaign.beginsAt || 0, new Date(), {locale: uk})}</p>}
                        {!isBefore(new Date(), campaign.beginsAt || 0) && <p>Закінчиться {formatRelative(campaign.endsAt || 0, new Date(), {locale: uk})}</p>}
                        
                    </div>
                </li>
            </a>
        ))}
    </ul>
</Layout>