---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { formatRelative, isBefore } from "date-fns";
import { uk } from "date-fns/locale";
import { applications } from "@db/schema";
import { eq } from "drizzle-orm";

const db = getDrizzle();
const campaigns = await db.query.campaigns.findMany({
    with: {
        profiles: {
            columns: { id: true, title: true },
        },
    },
    orderBy: {
        endsAt: "desc",
    },
});
---

<Layout title="Кампанії">
    <h1 class="mb-5">Кампанії</h1>
    <a href="campaigns/editor" class="btn-default">
        + Створити кампанію
    </a>
    <ul class="list-colors mt-5">
        {campaigns.map(async (campaign) => (
            <li
                class={`card mb-5 ${campaign.endsAt && !isBefore(new Date(), campaign.beginsAt || new Date(0)) && !isBefore(new Date(), campaign.endsAt || new Date(0)) ? "opacity-75" : ""}`}
            >
                <a
                    href={`/admin/campaigns/editor?campaign=${campaign.id}`}
                    class="w-full flex flex-row justify-between items-center gap-3"
                >
                    <h4>{campaign.title}</h4>
                    {campaign.beginsAt && isBefore(new Date(), campaign.beginsAt) && (
                        <p>Почнеться {formatRelative(new Date(campaign.beginsAt), new Date(), { locale: uk })}</p>
                    )}
                    {campaign.endsAt &&
                        !isBefore(new Date(), campaign.beginsAt || new Date(0)) &&
                        isBefore(new Date(), campaign.endsAt || new Date(0)) && (
                            <p>Закінчиться {formatRelative(new Date(campaign.endsAt), new Date(), { locale: uk })}</p>
                        )}
                    {campaign.endsAt &&
                        !isBefore(new Date(), campaign.beginsAt || new Date(0)) &&
                        !isBefore(new Date(), campaign.endsAt || new Date(0)) && (
                            <p>Закінчилась {formatRelative(new Date(campaign.endsAt), new Date(), { locale: uk })}</p>
                        )}
                </a>
                <a href={`/admin/applications?campaign=${campaign.id}`}>
                    <p>{await db.$count(applications, eq(applications.campaignId, campaign.id))} Заяв</p>
                </a>

                <ul>
                    {campaign.profiles.map((profile) => (
                        <li>
                            <a href={`/admin/campaigns/editor?campaign=${campaign.id}&profile=${profile.id}`}>
                                {profile.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </li>
        ))}
    </ul>
</Layout>
