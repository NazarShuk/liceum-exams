---
import Layout from "@layouts/Layout.astro";
import AdminSidebar from "@layouts/AdminSidebar.astro";
import { getDrizzle } from "@db/drizzle";
import CampaignEditor from "@components/CampaignEditor.svelte";
import type {campaigns, profiles} from "@db/schema"
type Campaign = typeof campaigns.$inferSelect & {profiles: (typeof profiles.$inferSelect)[]}

const db = getDrizzle();
let loadedCampaign: Campaign | undefined;

if (Astro.url.searchParams.has("campaign")) {
    const campaign = await db.query.campaigns.findFirst({
        where: { id: Number.parseInt(Astro.url.searchParams.get("campaign") || "-1") },
        with: {profiles: true}
    });

    if (campaign) {
        loadedCampaign = campaign;
    }
}
---

<Layout>
    <AdminSidebar slot="left-side" />
    <h1 class="mb-5">Редактор кампанії</h1>
    <CampaignEditor loadedCampaign={loadedCampaign} client:load />
</Layout>