---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import CampaignEditor from "@components/CampaignEditor.svelte";
import type {campaigns, forms, profiles} from "@db/schema";
type Campaign = typeof campaigns.$inferSelect & {profiles: (typeof profiles.$inferSelect)[]}
type Form = typeof forms.$inferSelect;

const db = getDrizzle();
let loadedCampaign: Campaign | undefined;

if (Astro.url.searchParams.has("campaign")) {
    const campaign = await db.query.campaigns.findFirst({
        where: { id: Number.parseInt(Astro.url.searchParams.get("campaign") || "-1") },
        with: {profiles: true}
    });

    if (campaign) {
        loadedCampaign = campaign;
    }
}
const availableProfiles = await db.query.profiles.findMany();
const availableForms: Form[] = await db.query.forms.findMany();
---

<Layout title={loadedCampaign ? loadedCampaign.title : "Нова кампанія"}>
    <h1 class="mb-5">Редактор кампанії</h1>
    <CampaignEditor loadedCampaign={loadedCampaign} availableProfiles={availableProfiles} availableForms={availableForms} client:load />
</Layout>
