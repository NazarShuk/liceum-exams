---
import Layout from "@layouts/Layout.astro";
import AdminSidebar from "@layouts/AdminSidebar.astro"
import { getDrizzle } from "@db/drizzle";

const db = getDrizzle()
const forms = await db.query.forms.findMany()
---

<Layout>
    <AdminSidebar slot={"left-side"} />
    <h1>Форми</h1>
    <a href="/admin/forms/editor">+ Створити форму</a>
    <ul>
        {forms.map(form => (
            <li>
                <a href={`/admin/forms/editor?form=${form.id}`}>
                    <div class="card mb-5">
                        <h4>
                            {form.title}
                        </h4>
                        <span class={`${form.visibility === "public" ? "text-diia-green" : "text-diia-red"}`}>{form.visibility === "public" ? "Опубліковано" : "Чернетка"}</span>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</Layout>