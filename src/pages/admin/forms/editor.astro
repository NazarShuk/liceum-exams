---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import FormEditor from "@components/FormEditor.svelte";
import type { forms } from "@db/schema";
type Form = NonNullable<typeof forms.$inferSelect>;

const db = getDrizzle()
let loadedForm : Form|undefined
if (Astro.url.searchParams.has("form")){
    const form = await db.query.forms.findFirst({where: {id: parseInt(Astro.url.searchParams.get("form") || "-1")}})
    if (form){
        loadedForm = form
    }
}
---

<Layout title={loadedForm ? loadedForm.title : "Нова форма"}>
    <h1 class="mb-5">Редактор форми</h1>
    <FormEditor loadedForm={loadedForm} client:load />
</Layout>
