---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import ProfileDisplay from "@components/ProfileDisplay.svelte";

const db = getDrizzle()
const profiles = await db.query.profiles.findMany()
---

<Layout title="Профілі">
    <h1>Профілі</h1>
    <a href="/admin/profiles/editor">+ Створити профіль</a>
    <ul>
        {profiles.map(profile => (
            <ProfileDisplay profile={profile} className="mb-5" href={`/admin/profiles/editor?profile=${profile.id}`} client:load />
        ))}
    </ul>
</Layout>
