---
import Layout from "@layouts/Layout.astro";
import NewsAdminList from "@components/NewsAdminList.svelte";
import { getDrizzle } from "@db/drizzle";

const db = getDrizzle();
const news = await db.query.news.findMany({
    columns: {
        id: true,
        title: true,
        tag: true,
        pinned: true,
        hidden: true,
        createdAt: true,
    },
    orderBy: {
        pinned: "desc",
        createdAt: "desc",
    },
});
---

<Layout title="Новини">
    <h1 class="mb-5">Новини</h1>
    <a href="/admin/news/editor" class="btn-default">
        + Створити новину
    </a>
    <NewsAdminList news={news} client:load />
</Layout>
