---
import Layout from "@layouts/Layout.astro";
import NewsAdminList from "@components/NewsAdminList.svelte";
import { getDrizzle } from "@db/drizzle";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const db = getDrizzle();
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const news = await db.query.news.findMany({
    columns: {
        id: true,
        title: true,
        tag: true,
        pinned: true,
        hidden: true,
        createdAt: true,
    },
    orderBy: {
        pinned: "desc",
        createdAt: "desc",
    },
});
---

<Layout title={t("admin.news.title")}>
    <h1 class="mb-5">{t("admin.news.title")}</h1>
    <a href={localizePath(locale, "/admin/news/editor")} class="btn-default">
        {t("admin.news.create")}
    </a>
    <NewsAdminList news={news} {locale} client:load />
</Layout>
