---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import NewsEditor from "@components/NewsEditor.svelte";
import type { news } from "@db/schema";
import { useTranslations } from "@i18n/index";

type News = typeof news.$inferSelect;

const db = getDrizzle();
const locale = Astro.locals.locale;
const t = useTranslations(locale);
let loadedNews: News | undefined;

if (Astro.url.searchParams.has("news")) {
    const item = await db.query.news.findFirst({
        where: { id: Number.parseInt(Astro.url.searchParams.get("news") || "-1") },
    });

    if (item) {
        loadedNews = item;
    }
}
---

<Layout title={loadedNews ? loadedNews.title : t("news.newTitle")}>
    <h1 class="mb-5">{t("news.editorTitle")}</h1>
    <NewsEditor loadedNews={loadedNews} {locale} client:load />
</Layout>
