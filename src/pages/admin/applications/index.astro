---
import { getDrizzle } from "@db/drizzle";
import AdminSidebar from "@layouts/AdminSidebar.astro";
import Layout from "@layouts/Layout.astro"
import ApplicationsTable from "@components/ApplicationsTable.svelte";

const db = getDrizzle()
const applications = await db.query.applications.findMany({
    where: {state: "submitted"},
    with: {student: true, user: true}
})
const campaigns = await db.query.campaigns.findMany({
    with: {
        profiles: {
            with: {form: true}
        }
    }
})
---

<Layout>
    <AdminSidebar slot={"left-side"} />
    <h1>Заяви</h1>
    {campaigns.length > 0
        ? <ApplicationsTable applications={applications} campaigns={campaigns} client:load></ApplicationsTable>
        : <p>Кампаній ще немає.</p>}
</Layout>
