---
import { getDrizzle } from "@db/drizzle";
import Layout from "@layouts/Layout.astro";
import ApplicationsTable from "@components/ApplicationsTable.svelte";
import { useTranslations } from "@i18n/index";

const db = getDrizzle();
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const applications = await db.query.applications.findMany({
    where: { state: "submitted" },
    with: { student: true, user: true },
});
const campaigns = await db.query.campaigns.findMany({
    with: {
        profiles: {
            with: { form: true },
        },
    },
});
const teachers = await db.query.users.findMany({
    where: { role: "teacher" },
    orderBy: { lastName: "asc" },
});
const groups = await db.query.groups.findMany({
    columns: { id: true, title: true },
    orderBy: { title: "asc" },
});
---

<Layout title={t("admin.applications.title")}>
    <div class="flex h-[calc(100svh-4.5rem)] min-h-0 flex-col overflow-hidden">
        <h1 class="shrink-0">{t("admin.applications.title")}</h1>
        {campaigns.length > 0 ? (
            <ApplicationsTable
                applications={applications}
                campaigns={campaigns}
                teachers={teachers}
                groups={groups}
                allowGroupCreate
                allowStatusEdit
                fillHeight
                {locale}
                client:load
            />
        ) : (
            <p>{t("admin.applications.emptyCampaigns")}</p>
        )}
    </div>
</Layout>
