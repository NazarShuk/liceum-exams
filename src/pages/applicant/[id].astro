---
import Layout from "@layouts/Layout.astro";
import HeroBackground from "@components/HeroBackground.astro";
import GoogleSignIn from "@components/GoogleSignIn.astro";
import { getDrizzle } from "@db/drizzle";
import { statusClass, statusLabel } from "@lib/status";
import { parseDbDate } from "@lib/dates";
import { formatDateLong } from "@i18n/dates";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

if (Astro.locals.user) {
    return Astro.redirect(localizePath(locale, "/cabinet"));
}

const db = getDrizzle();
const applicantInvite = await db.query.applicantInvites.findFirst({
    where: { id: Astro.params.id },
    with: {
        application: {
            with: {
                student: true,
                campaign: { columns: { title: true } },
                profile: { columns: { title: true } },
            },
        },
    },
});
const application = applicantInvite?.application;
if (!applicantInvite || !application) {
    return new Response(null, { status: 404 });
}

const studentName = application.student ? `${application.student.firstName} ${application.student.lastName}` : "";
---

<Layout noPadding title={t("applicant.title")}>
    <section class="relative isolate min-h-[calc(100svh-0.5rem)] overflow-hidden px-5 py-16 sm:px-8 lg:px-12">
        <HeroBackground />

        <div class="relative mx-auto flex w-full max-w-2xl flex-col gap-10">
            <div>
                <h1>
                    {studentName
                        ? t("applicant.greeting", { name: application.student?.firstName ?? "" })
                        : t("applicant.welcome")}
                </h1>
                <p class="mt-6 text-[17px]/[26px] text-black/65 sm:text-[19px]/[30px]">
                    {t("applicant.access", { profile: application.profile?.title ?? "" })}
                </p>
                <div class="mt-8">
                    <GoogleSignIn inviteId={applicantInvite.id} />
                </div>
            </div>

            <div class="card flex flex-row items-start gap-4 bg-card">
                <div class="flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                        <h4>{studentName || t("common.application")}</h4>
                        <span class={`rounded-full px-3 py-0.5 text-sm ${statusClass(application.status)}`}>
                            {statusLabel(application.status, locale, !!application.notes)}
                        </span>
                    </div>
                    <p class="mt-1">
                        {application.campaign?.title} - {application.profile?.title}
                    </p>
                    <p class="mt-1 text-sm text-black/55">
                        {application.createdAt ? formatDateLong(parseDbDate(application.createdAt), locale) : ""}
                    </p>
                    {application.notes && (
                        <p class="mt-3 whitespace-pre-wrap text-sm">
                            <strong>{t("applicant.notes")}</strong> {application.notes}
                        </p>
                    )}
                </div>
            </div>
        </div>
    </section>
</Layout>
