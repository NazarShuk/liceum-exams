---
import Layout from "@layouts/Layout.astro";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);
const body = t("about.body").replaceAll('href="/contacts"', `href="${localizePath(locale, "/contacts")}"`);
---

<Layout title={t("nav.about")}>
    <section>
        <div set:html={body} />
    </section>
</Layout>

<style>
    .name-link {
        display: inline-block;
    }

    .name-link:hover {
        background-image: linear-gradient(90deg, var(--color-black), #7c3aed, var(--color-black));
        background-size: 200% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-family: "Comic Sans MS", "Comic Sans", cursive;
        font-weight: bold;
        animation:
            rainbow 2s linear infinite,
            wobble 0.4s ease-in-out infinite alternate;
    }

    .name-link:focus-visible {
        outline: 2px solid var(--color-liceum-blue);
        outline-offset: 4px;
    }

    @keyframes rainbow {
        to {
            background-position: 200% 0;
        }
    }

    @keyframes wobble {
        from {
            transform: scale(1);
        }
        to {
            transform: scale(2);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .name-link:hover {
            animation: none;
            transform: scale(1.5);
        }
    }
</style>
