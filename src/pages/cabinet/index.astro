---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import {format} from "date-fns"
import { uk } from "date-fns/locale";
import { actions } from "astro:actions";

const db = getDrizzle()
const results = await db.query.applications.findMany({
    where: {
        userId: Astro.locals.user.role !== "applicant" ? Astro.locals.user.id : undefined,
        studentId: Astro.locals.user.role === "applicant" ? Astro.locals.user.id : undefined
    },
    with: {student: true, profile: {columns: {title: true}}, campaign: {columns: {title: true}}},
})

const linkResult = Astro.getActionResult(actions.applicantLink)
---

<Layout title="Мої заяви">
    <h1 class="mb-5">Мої заяви</h1>
    
    <ul class="mt-5 list-colors">
        <a href="/cabinet/application">
            <li class="mb-5 border-dashed border-2 border-diia-grey py-7 px-6 flex flex-row justify-center items-center gap-1 rounded">
                <span class="material-symbols-outlined">
                    add_circle
                </span>
                <h4>Створити заяву</h4>
            </li>
        </a>
        {results.length === 0 && <p class="text-center opacity-75">У Вас поки що немає заяв! Натисніть на кнопку вище щоб створити Вашу першу заяву.</p>}
        {results.map(result => {
            const isDraft = result.state === "draft";
            const draftStudent = (result.answers?.__student ?? {}) as { firstName?: string; lastName?: string };
            const studentName = result.student
                ? `${result.student.firstName} ${result.student.lastName}`
                : [draftStudent.firstName, draftStudent.lastName].filter(Boolean).join(" ");
            return (
                <li class={`card mb-5 ${isDraft ? "opacity-75 border-dotted" : ""}`}>
                    <a href={isDraft ? `/cabinet/application?draft=${result.id}` : `/cabinet/application?preview=${result.id}`}>
                        <h4>{studentName || "Заява"}</h4>
                        <p>{result.campaign?.title} - {result.profile?.title}</p>
                        <p class="opacity-50">
                            {isDraft ? "Чернетка" : "Подано"} {result.createdAt ? format(new Date(result.createdAt), "PPP", {locale: uk}) : ''}
                        </p>
                    </a>

                    {isDraft && (
                        <form method="POST" action={actions.deleteDraft} onsubmit="return confirm('Видалити чернетку?')">
                            <input hidden name="applicationId" value={result.id}>
                            <button class="cursor-pointer">Видалити чернетку</button>
                        </form>
                    )}

                    {!isDraft && Astro.locals.user.role !== "applicant" && (
                        <form method="POST" action={actions.applicantLink}>
                            <input hidden name="applicationId" value={result.id}>
                            <button class="cursor-pointer">Посилання для абітурієнта</button>
                        </form>
                    )}
                </li>
            );
        })}
    </ul>

    {linkResult && linkResult.data?.id && (
        <div
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-5"
            role="presentation"
        >
            <div
                class="card flex w-full max-w-2xl flex-col gap-5 bg-white max-h-screen overflow-auto text-center"
                role="dialog"
                aria-modal="true"
            >
                <h4>Посилання для абітурієнта</h4>
                <p class="text-center text-diia-blue">{`${Astro.url.origin}/applicant/${linkResult.data.id}`}</p>
                <div class="flex flex-row gap-5 items-center justify-center">
                    <button class="btn-default flex flex-row items-center gap-1" onclick={`navigator.clipboard.writeText("${`${Astro.url.origin}/applicant/${linkResult.data.id}`}")`}>
                        <span class="material-symbols-outlined">
                            content_copy
                        </span>
                        Копіювати
                    </button>
                    <button class="btn-default flex flex-row items-center gap-1" onclick={`navigator.share({text:"${`${Astro.url.origin}/applicant/${linkResult.data.id}`}"})`}>
                        <span class="material-symbols-outlined">
                            share
                        </span>
                        Поділитися    
                    </button>
                </div>
                <p>Надішліть це посилання абітурієнту. Абітурієнт зможе зареєструватися та слідкувати за заявою самостійно.</p>
                <button class="cursor-pointer" onclick="window.location.reload()">Закрити</button>
            </div>
        </div>
    )}
</Layout>
