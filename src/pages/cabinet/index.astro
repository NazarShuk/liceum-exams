---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { parseDbDate } from "@lib/dates";
import { statusClass, statusLabel } from "@lib/status";
import { actions } from "astro:actions";
import { formatDateLong } from "@i18n/dates";
import { localizePath } from "@i18n/config";
import { translateMessage, useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const db = getDrizzle();
const now = new Date();
const availableCampaigns = await db.query.campaigns.findMany({
    where: {
        AND: [
            { OR: [{ beginsAt: { isNull: true } }, { beginsAt: { lt: now } }] },
            { OR: [{ endsAt: { isNull: true } }, { endsAt: { gt: now } }] },
        ],
    },
    with: {
        profiles: {
            where: { formId: { isNotNull: true } },
            columns: { id: true },
        },
    },
    columns: { id: true },
});
const hasAvailableCampaigns = availableCampaigns.some((campaign) => campaign.profiles.length > 0);

const results = await db.query.applications.findMany({
    where: {
        userId: Astro.locals.user.role !== "applicant" ? Astro.locals.user.id : undefined,
        studentId: Astro.locals.user.role === "applicant" ? Astro.locals.user.id : undefined,
    },
    with: { student: true, profile: { columns: { title: true } }, campaign: { columns: { title: true } } },
});

const linkResult = Astro.getActionResult(actions.applicantLink);
const applicantUrl = linkResult?.data?.id
    ? new URL(localizePath(locale, `/applicant/${linkResult.data.id}`), Astro.url.origin).toString()
    : "";
---

<Layout title={t("cabinet.title")}>
    <h1 class="mb-5">{t("cabinet.title")}</h1>

    {linkResult?.error && (
        <p class="mt-2 text-diia-red" role="alert">
            {translateMessage(locale, linkResult.error.message)}
        </p>
    )}

    <ul class="mt-5 list-colors">
        {Astro.locals.user.role !== "applicant" && hasAvailableCampaigns && (
            <a href={localizePath(locale, "/cabinet/application")}>
                <li class="mb-5 border-dashed border-2 border-diia-grey py-7 px-6 flex flex-row justify-center items-center gap-1 rounded">
                    <span class="material-symbols-outlined">add_circle</span>
                    <h4>{t("cabinet.create")}</h4>
                </li>
            </a>
        )}
        {Astro.locals.user.role !== "applicant" && !hasAvailableCampaigns && (
            <p class="mb-5 text-center opacity-75">{t("cabinet.noCampaigns")}</p>
        )}
        {results.length === 0 && (
            <p class="text-center opacity-75">
                {Astro.locals.user.role === "applicant"
                    ? t("cabinet.emptyApplicant")
                    : hasAvailableCampaigns
                      ? t("cabinet.emptyParent")
                      : t("cabinet.emptyApplicant")}
            </p>
        )}
        {results.map((result) => {
            const isDraft = result.state === "draft";
            const draftStudent = (result.answers?.__student ?? {}) as { firstName?: string; lastName?: string };
            const studentName = result.student
                ? `${result.student.firstName} ${result.student.lastName}`
                : [draftStudent.firstName, draftStudent.lastName].filter(Boolean).join(" ");
            const statusText = isDraft ? t("cabinet.draft") : statusLabel(result.status, locale, !!result.notes);
            return (
                <li class={`card mb-5 ${isDraft ? "opacity-75 border-dotted" : ""} flex flex-col gap-4`}>
                    <a
                        class="flex-1"
                        href={localizePath(
                            locale,
                            isDraft
                                ? `/cabinet/application?draft=${result.id}`
                                : `/cabinet/application?preview=${result.id}`,
                        )}
                    >
                        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                            <h4>{studentName || t("cabinet.applicationFallback")}</h4>
                            <span
                                class={`rounded-full px-3 py-0.5 text-sm ${isDraft ? "bg-diia-grey/15 text-black/55" : statusClass(result.status)} ${!isDraft && result.status === "attention" ? "status-attention" : ""}`}
                            >
                                {statusText}
                            </span>
                        </div>
                        <p class="mt-1">
                            {result.campaign?.title} - {result.profile?.title}
                        </p>
                        <p class="mt-1 text-sm text-black/55">
                            {result.createdAt ? formatDateLong(parseDbDate(result.createdAt), locale) : ""}
                        </p>
                    </a>

                    {(isDraft || Astro.locals.user.role !== "applicant") && (
                        <div class="flex flex-row gap-2">
                            {!isDraft && (
                                <form method="POST" action={actions.applicantLink}>
                                    <input hidden name="applicationId" value={result.id} />
                                    <button
                                        class="flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-liceum-blue px-3.5 text-sm text-liceum-blue transition-colors hover:bg-liceum-blue/5"
                                        title={t("cabinet.shareTooltip")}
                                    >
                                        <span class="material-symbols-outlined text-[18px]">share</span>
                                        {t("cabinet.share")}
                                    </button>
                                </form>
                            )}

                            {isDraft && (
                                <form
                                    method="POST"
                                    action={actions.deleteDraft}
                                    onsubmit={`return confirm(${JSON.stringify(t("cabinet.deleteDraftConfirm"))})`}
                                >
                                    <input hidden name="applicationId" value={result.id} />
                                    <button
                                        class="flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-liceum-red px-3.5 text-sm text-liceum-red transition-colors hover:bg-liceum-red/10"
                                        title={t("cabinet.deleteDraftTooltip")}
                                    >
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                        {t("cabinet.deleteDraft")}
                                    </button>
                                </form>
                            )}
                        </div>
                    )}
                </li>
            );
        })}
    </ul>

    {linkResult && linkResult.data?.id && (
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-overlay/50 p-5" role="presentation">
            <div
                class="card flex w-full max-w-2xl flex-col gap-5 bg-white max-h-screen overflow-auto text-center"
                role="dialog"
                aria-modal="true"
            >
                <h4>{t("cabinet.shareTitle")}</h4>
                <p class="text-center text-diia-blue wrap-break-word">{applicantUrl}</p>
                <div class="flex flex-row gap-5 items-center justify-center flex-wrap">
                    <button
                        class="btn-default flex flex-row items-center gap-1"
                        onclick={`navigator.clipboard.writeText(${JSON.stringify(applicantUrl)})`}
                    >
                        <span class="material-symbols-outlined">content_copy</span>
                        {t("cabinet.copy")}
                    </button>
                    <button
                        class="btn-default flex flex-row items-center gap-1"
                        onclick={`navigator.share({text:${JSON.stringify(applicantUrl)}})`}
                    >
                        <span class="material-symbols-outlined">share</span>
                        {t("cabinet.shareAction")}
                    </button>
                </div>
                <p>{t("cabinet.linkExplanation")}</p>
                <button class="btn-default bg-brand-red! mx-auto" onclick="window.location.reload()">
                    {t("common.close")}
                </button>
            </div>
        </div>
    )}
</Layout>
