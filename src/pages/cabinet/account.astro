---
import Layout from "../../layouts/Layout.astro";
import CabinetHead from "../../layouts/CabinetHead.astro";
import { getDrizzle } from "../../db/drizzle";
import { actions } from "astro:actions";
import { users } from "../../db/schema";
import { eq } from "drizzle-orm";

const result = Astro.getActionResult(actions.logout);
if (result && !result.error){
  return Astro.redirect("/");
}

const db = getDrizzle()
const user = (await db.select().from(users).where(eq(users.id, Astro.locals.user.sub)))[0]
if (!user){
    return Astro.redirect("/")
}
---

<Layout>
    <CabinetHead />

    <ul>
        <li>Ім'я {user?.firstName} {user?.lastName}</li>
        <li>Телефон {user.phone}</li>
    </ul>

    <form action={actions.logout} method="POST">
        <button class="btn-default">Вийти</button>
    </form>
</Layout>