---
import Layout from "@layouts/Layout.astro";
import { actions } from "astro:actions";
import { parseDbDate } from "@lib/dates";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const result = Astro.getActionResult(actions.logout);
if (result && !result.error) {
    return Astro.redirect(localizePath(locale, "/"));
}
---

<Layout title={t("account.title")}>
    <h1>{t("account.title")}</h1>
    <div class="card flex flex-col gap-5 my-5">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <label class="flex flex-col gap-1">
                {t("common.firstName")}
                <input readonly value={Astro.locals.user?.firstName ?? ""} />
            </label>
            <label class="flex flex-col gap-1">
                {t("common.lastName")}
                <input readonly value={Astro.locals.user?.lastName ?? ""} />
            </label>
            <label class="flex flex-col gap-1">
                {t("common.middleName")}
                <input readonly value={Astro.locals.user?.middleName ?? ""} />
            </label>
        </div>
        <label class="flex flex-col gap-1">
            {t("common.birthDate")}
            <input
                readonly
                type="date"
                value={
                    Astro.locals.user?.birthDate
                        ? parseDbDate(Astro.locals.user?.birthDate).toISOString().slice(0, 10)
                        : ""
                }
            />
        </label>
        <label class="flex flex-col gap-1">
            {t("common.phone")}
            <input readonly type="tel" value={Astro.locals.user?.phone ?? ""} />
        </label>
    </div>

    <form action={actions.logout} method="POST">
        <button class="btn-default bg-brand-red!">{t("account.logout")}</button>
    </form>
</Layout>
