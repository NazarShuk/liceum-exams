---
import Layout from "@layouts/Layout.astro";
import { actions } from "astro:actions";
import { parseDbDate } from "@lib/dates";

const result = Astro.getActionResult(actions.logout);
if (result && !result.error) {
    return Astro.redirect("/");
}
---

<Layout title="Аккаунт">
    <h1>Аккаунт</h1>
    <div class="card flex flex-col gap-5 my-5">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <label class="flex flex-col gap-1">
                Ім'я
                <input readonly value={Astro.locals.user?.firstName ?? ""} />
            </label>
            <label class="flex flex-col gap-1">
                Прізвище
                <input readonly value={Astro.locals.user?.lastName ?? ""} />
            </label>
            <label class="flex flex-col gap-1">
                По батькові
                <input readonly value={Astro.locals.user?.middleName ?? ""} />
            </label>
        </div>
        <label class="flex flex-col gap-1">
            Дата народження
            <input
                readonly
                type="date"
                value={
                    Astro.locals.user?.birthDate
                        ? parseDbDate(Astro.locals.user?.birthDate).toISOString().slice(0, 10)
                        : ""
                }
            />
        </label>
        <label class="flex flex-col gap-1">
            Телефон
            <input readonly type="tel" value={Astro.locals.user?.phone ?? ""} />
        </label>
    </div>

    <form action={actions.logout} method="POST">
        <button class="btn-default bg-brand-red!">Вийти</button>
    </form>
</Layout>
