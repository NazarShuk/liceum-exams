---
import Layout from "@layouts/Layout.astro";
import CabinetHead from "@layouts/CabinetHead.astro";
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.logout);
if (result && !result.error){
  return Astro.redirect("/");
}
---

<Layout title="Аккаунт">
    <CabinetHead />

    <ul>
        <li>Ім'я {Astro.locals.user?.firstName} {Astro.locals.user?.lastName}</li>
        <li>Роль {Astro.locals.user.role === "applicant" && "Абітурієнт"} {Astro.locals.user.role === "parent" && "Опікун"}</li>
        <li>Телефон {Astro.locals.user.phone}</li>
    </ul>

    <form action={actions.logout} method="POST">
        <button class="btn-default">Вийти</button>
    </form>
</Layout>
