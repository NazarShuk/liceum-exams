---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { format } from "date-fns";
import { uk } from "date-fns/locale";
import { renderMarkdown } from "../../lib/markdown";
import { dbTimestamp, parseDbDate } from "@lib/dates";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";

const db = getDrizzle();
const item = await db.query.news.findFirst({
    where: { id: Number.parseInt(Astro.params.id || "-1") },
});

if (!item) {
    return new Response(null, { status: 404 });
}

const html = renderMarkdown(item.content);
if (Astro.locals.user) {
    await db
        .update(users)
        .set({
            lastNewsRead: dbTimestamp(),
        })
        .where(eq(users.id, Astro.locals.user.id));
}
---

<Layout title={item.title}>
    <section class="mx-auto flex max-w-5xl flex-col gap-5 px-5 py-12 sm:px-8">
        <div>
            <a href="/news">{"<-"} Усі новини</a>
            <h1 class="mt-3 text-balance">{item.title}</h1>
            <p class="pt-2 text-sm opacity-70">
                {item.tag} | {format(parseDbDate(item.createdAt), "d MMMM yyyy", { locale: uk })}
            </p>
        </div>

        <div class="markdown" set:html={html} />
    </section>
</Layout>

<style>
    .markdown > :global(* + *) {
        margin-top: 1rem;
    }

    .markdown :global(h2),
    .markdown :global(h3),
    .markdown :global(h4) {
        margin-top: 2rem;
    }

    .markdown :global(ul) {
        list-style: disc;
        padding-left: 1.5rem;
    }

    .markdown :global(ol) {
        list-style: decimal;
        padding-left: 1.5rem;
    }

    .markdown :global(li + li) {
        margin-top: 0.5rem;
    }

    .markdown :global(a) {
        color: #234a99;
        text-decoration: underline;
    }

    .markdown :global(blockquote) {
        border-left: 4px solid #e7eef3;
        padding-left: 1rem;
        color: rgb(0 0 0 / 0.65);
    }

    .markdown :global(code) {
        background: #e7eef3;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.9em;
    }

    .markdown :global(pre) {
        overflow-x: auto;
        background: #18181b;
        color: #f4f4f5;
        padding: 1rem;
        border-radius: 0.5rem;
    }

    .markdown :global(pre code) {
        background: transparent;
        padding: 0;
    }

    .markdown :global(img) {
        max-width: 100%;
        height: auto;
    }

    .markdown :global(hr) {
        border-color: #e7eef3;
    }
</style>
