---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { format } from "date-fns";
import { uk } from "date-fns/locale";
import { carta } from "@lib/markdown";
import { dbTimestamp, parseDbDate } from "@lib/dates";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";

const db = getDrizzle();
const item = await db.query.news.findFirst({
    where: { id: Number.parseInt(Astro.params.id || "-1") },
});

if (!item) {
    return new Response(null, { status: 404 });
}

const html = carta.renderSSR(item.content);
if (Astro.locals.user) {
    await db
        .update(users)
        .set({
            lastNewsRead: dbTimestamp(),
        })
        .where(eq(users.id, Astro.locals.user.id));
}
---

<Layout title={item.title}>
    <section class={`${!Astro.locals.user ? "mx-auto max-w-5xl px-5 py-12 sm:px-8" : ""}`}>
        <div>
            <a href="/news">{"<-"} Усі новини</a>
            <h1 class="mt-3 text-balance">{item.title}</h1>
            <p class="pt-2 text-sm opacity-70">
                <a href={`/news?tag=${encodeURIComponent(item.tag)}`} class="text-liceum-blue">
                    {item.tag}
                </a>
                | {format(parseDbDate(item.createdAt), "d MMMM yyyy", { locale: uk })}
            </p>
        </div>

        <div class="carta-viewer carta-theme__default markdown-body" set:html={html} />
    </section>
</Layout>
