---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { carta } from "@lib/markdown";
import { dbTimestamp, parseDbDate } from "@lib/dates";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";
import { formatDate } from "@i18n/dates";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const db = getDrizzle();
const item = await db.query.news.findFirst({
    where: { id: Number.parseInt(Astro.params.id || "-1") },
});

const isAdmin = Astro.locals.user?.role === "admin";
if (!item || (item.hidden && !isAdmin)) {
    return new Response(null, { status: 404 });
}

const html = carta.renderSSR(item.content);
if (Astro.locals.user) {
    await db
        .update(users)
        .set({
            lastNewsRead: dbTimestamp(),
        })
        .where(eq(users.id, Astro.locals.user.id));
}
const newsPath = localizePath(locale, "/news");
---

<Layout title={item.title}>
    <section>
        <div>
            <div class="flex flex-wrap items-center justify-between gap-3">
                <a href={newsPath}>
                    {"<-"} {t("news.backToAll")}
                </a>
                {isAdmin && (
                    <a
                        href={`${localizePath(locale, "/admin/news/editor")}?news=${item.id}`}
                        class="flex h-9 w-fit cursor-pointer items-center gap-1.5 rounded-full border border-liceum-blue px-3.5 text-sm text-liceum-blue transition-colors hover:bg-liceum-blue/5"
                    >
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                        {t("news.edit")}
                    </a>
                )}
            </div>
            <h1 class="mt-3 text-balance">{item.title}</h1>
            {item.hidden && (
                <p class="mt-3 rounded bg-diia-gorse px-4 py-2 text-sm text-liceum-orange">{t("news.hiddenNotice")}</p>
            )}
            <p class="pt-2 text-sm opacity-70">
                <a href={`${newsPath}?tag=${encodeURIComponent(item.tag)}`} class="text-liceum-blue">
                    {item.tag}
                </a>
                | {formatDate(parseDbDate(item.createdAt), locale)}
            </p>
        </div>

        <div class="carta-viewer carta-theme__default markdown-body" set:html={html} />
    </section>
</Layout>
