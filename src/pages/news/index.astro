---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { format } from "date-fns";
import { uk } from "date-fns/locale";
import { markdownExcerpt } from "../../lib/markdown";

const db = getDrizzle();
const news = await db.query.news.findMany({
    orderBy: {
        createdAt: "desc"
    }
});
---

<Layout title="Новини">
    <h1>Новини</h1>
    <a href="/">На головну</a>
    {news.length === 0 && <p class="mt-5">Новин поки що немає.</p>}
    <ul class="mt-5">
        {news.map(item => (
             <li>
                <a href={`/news/${item.id}`}>
                    <div class="card mb-5">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <span class="rounded-full bg-diia-bright-grey px-3 py-1 text-sm text-liceum-blue">
                                {item.tag}
                            </span>
                            <time datetime={new Date(item.createdAt).toISOString()} class="text-sm text-black/60">
                                {format(new Date(item.createdAt), "d MMMM yyyy", { locale: uk })}
                            </time>
                        </div>
                        <h4 class="mt-2">{item.title}</h4>
                        <p class="text-black/65">{markdownExcerpt(item.content, 160)}</p>
                    </div>
                </a>
            </li>
        ))}
    </ul>
</Layout>