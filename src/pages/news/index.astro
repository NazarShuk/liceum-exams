---
import Layout from "@layouts/Layout.astro";
import { getDrizzle } from "@db/drizzle";
import { markdownExcerpt } from "../../lib/markdown";
import { dbTimestamp, parseDbDate } from "@lib/dates";
import { users } from "@db/schema";
import { eq } from "drizzle-orm";
import { compareText, formatDate } from "@i18n/dates";
import { localizePath } from "@i18n/config";
import { useTranslations } from "@i18n/index";

const locale = Astro.locals.locale;
const t = useTranslations(locale);

const db = getDrizzle();
const news = await db.query.news.findMany({
    where: { hidden: false },
    orderBy: {
        pinned: "desc",
        createdAt: "desc",
    },
});
if (Astro.locals.user) {
    await db
        .update(users)
        .set({
            lastNewsRead: dbTimestamp(),
        })
        .where(eq(users.id, Astro.locals.user.id));
}

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const activeTag = (Astro.url.searchParams.get("tag") ?? "").trim();
const tags = [...new Set(news.map((item) => item.tag))].sort((a, b) => compareText(a, b, locale));

// shortcut: filters the whole news table in memory; move to SQL if the table grows.
const filteredNews = news.filter((item) => {
    if (activeTag && item.tag !== activeTag) return false;
    if (!query) return true;
    const needle = query.toLowerCase();
    return [item.title, item.tag, item.content].some((value) => value.toLowerCase().includes(needle));
});
const newsPath = localizePath(locale, "/news");
---

<Layout title={t("news.title")}>
    <section>
        <h1>{t("news.title")}</h1>
        <form method="get" class="mt-5 grid gap-3 sm:flex sm:flex-wrap sm:items-end" role="search">
            <label class="min-w-0 sm:flex-1">
                <span class="sr-only">{t("news.searchLabel")}</span>
                <input type="search" name="q" value={query} placeholder={t("news.searchPlaceholder")} class="w-full" />
            </label>
            <label class="min-w-0 sm:flex-1">
                <span class="sr-only">{t("news.categoryLabel")}</span>
                <select name="tag" class="w-full" onchange="this.form.requestSubmit()">
                    <option value="">{t("news.allCategories")}</option>
                    {tags.map((tag) => (
                        <option value={tag} selected={tag === activeTag}>
                            {tag}
                        </option>
                    ))}
                </select>
            </label>
            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" class="btn-default">
                    {t("news.find")}
                </button>
                <a href={newsPath} class={query || activeTag ? "" : "invisible"} aria-hidden={!query && !activeTag}>
                    {t("news.reset")}
                </a>
            </div>
        </form>
        {filteredNews.length === 0 && <p class="mt-5">{news.length === 0 ? t("news.empty") : t("news.noResults")}</p>}
        <ul class="mt-5 list-colors">
            {filteredNews.map((item) => (
                <li>
                    <div class="card mb-5">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div class="flex flex-wrap items-center gap-2">
                                {item.pinned && (
                                    <span
                                        class="material-symbols-outlined text-[20px] text-diia-grey"
                                        title={t("news.pinned")}
                                        aria-label={t("news.pinned")}
                                        role="img"
                                    >
                                        push_pin
                                    </span>
                                )}
                                <a
                                    href={`${newsPath}?tag=${encodeURIComponent(item.tag)}`}
                                    class="rounded-full bg-diia-bright-grey px-3 py-1 text-sm text-liceum-blue transition-colors hover:brightness-95"
                                >
                                    {item.tag}
                                </a>
                            </div>
                            <time datetime={parseDbDate(item.createdAt).toISOString()} class="text-sm text-black/60">
                                {formatDate(parseDbDate(item.createdAt), locale)}
                            </time>
                        </div>
                        <a href={localizePath(locale, `/news/${item.id}`)} class="mt-2 block">
                            <h4>{item.title}</h4>
                            <p class="text-black/65">{markdownExcerpt(item.content, 160)}</p>
                        </a>
                    </div>
                </li>
            ))}
        </ul>
    </section>
</Layout>
