---
interface Props {
    inviteId?: string;
}

const href = Astro.props.inviteId
    ? `/api/google?start=1&invite=${encodeURIComponent(Astro.props.inviteId)}`
    : "/api/google?start=1";
---

<a
    href={href}
    class="btn-default"
    data-astro-reload
    data-astro-prefetch="false"
    onclick="if (this.dataset.busy) return false; this.dataset.busy = '1'; setTimeout(() => { delete this.dataset.busy; }, 5000);"
>
    <span>Увійти з Google {"->"}</span>
</a>
