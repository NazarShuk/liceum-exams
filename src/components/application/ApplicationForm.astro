---
import { actions } from "astro:actions";
import FormField from "@components/FormField.astro";
import type { campaigns, profiles, forms, users } from "@db/schema";

type Form = typeof forms.$inferSelect;
type Campaign = typeof campaigns.$inferSelect;
type Profile = typeof profiles.$inferSelect;
type User = typeof users.$inferSelect;
type FormFieldSchema = Form["schema"][number];

interface ProfileWithForm extends Profile {
  form: Form | null;
}

interface CampaignWithProfiles extends Campaign {
  profiles: ProfileWithForm[];
}

interface Props {
  selectedForm: Form;
  selectedCampaign: CampaignWithProfiles | undefined;
  selectedProfile: ProfileWithForm;
  user: User;
  children?: User[];
}

const { selectedForm, selectedCampaign, selectedProfile, user, children = [] } = Astro.props;
---

<section class="flex flex-col gap-5">
  <a
    href={`/cabinet/application?campaignId=${selectedCampaign?.id}`}
    class="self-start"
  >
    {"<-"} Назад до профілів
  </a>

  <div>
    <h2>{selectedForm.title}</h2>
    {selectedForm.description && (
      <p class="pt-2">{selectedForm.description}</p>
    )}
  </div>

  <form class="flex flex-col" action={actions.submitForm} method="POST">
    <div class="card flex flex-col gap-5 mb-5">
      <h3>Інформація учня</h3>
      {children.length > 0 && (
        <label class="flex flex-col gap-1">
          Оберіть учня
          <select id="studentSelect">
            <option value="">Новий учень</option>
            {children.map((child) => (
              <option value={child.id}>{child.firstName} {child.lastName} {child.middleName || ""}</option>
            ))}
          </select>
        </label>
      )}
      <input type="hidden" name="studentId" id="studentIdInput" />
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <label class="flex flex-col gap-1">
          Ім'я
          <input name="studentfirstName" id="studentfirstName" required placeholder="..." />
        </label>
        <label class="flex flex-col gap-1">
          Прізвище
          <input name="studentlastName" id="studentlastName" required placeholder="..." />
        </label>
        <label class="flex flex-col gap-1">
          По батькові
          <input name="studentmiddleName" id="studentmiddleName" placeholder="..." />
        </label>
      </div>
      <label class="flex flex-col gap-1">
        Дата народження
        <input name="studentBirthDate" id="studentBirthDate" type="date" required />
      </label>
      <label class="flex flex-col gap-1">
        Телефон
        <input name="studentTelephone" id="studentTelephone" type="tel" pattern="380\d{9}" required placeholder="380XXXXXXXXX" />
      </label>
    </div>

    <div class="card flex flex-col gap-5 mb-5">
      <h3>Інформація батьків</h3>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <label class="flex flex-col gap-1">
          Ім'я
          <input name="parentfirstName" required value={user.firstName} placeholder="..." />
        </label>
        <label class="flex flex-col gap-1">
          Прізвище
          <input name="parentlastName" required value={user.lastName} placeholder="..." />
        </label>
        <label class="flex flex-col gap-1">
          По батькові
          <input name="parentmiddleName" value={user.middleName} placeholder="..." />
        </label>
      </div>
      <label class="flex flex-col gap-1">
        Дата народження
        <input
          name="parentBirthDate"
          type="date"
          required
          value={user.birthDate ? new Date(user.birthDate as any).toISOString().slice(0, 10) : ""}
        />
      </label>
      <label class="flex flex-col gap-1">
        Телефон
        <input name="parentTelephone" type="tel" required value={user.phone} pattern="380\d{9}" placeholder="380XXXXXXXXX" />
      </label>
    </div>

    {selectedForm.schema.length > 0 && (
      <div>
        {selectedForm.schema.map((field: FormFieldSchema) => (
          <FormField preview={false} previewValue={undefined} {field} />
        ))}
      </div>
    )}

    <input type="hidden" name="formId" value={selectedForm.id} />
    <input type="hidden" name="profileId" value={selectedProfile.id} />
    <button class="btn-default">Надіслати</button>
    <p class="opacity-75">Натискаючи кнопку "Надіслати", ви надаєте згоду на обробку ваших персональних даних відповідно до Закону України "Про захист персональних даних"</p>
  </form>
  <script define:vars={{ children }} is:inline>
    const select = document.getElementById('studentSelect');
    const studentIdInput = document.getElementById('studentIdInput');
    const firstName = document.getElementById('studentfirstName');
    const lastName = document.getElementById('studentlastName');
    const middleName = document.getElementById('studentmiddleName');
    const birthDate = document.getElementById('studentBirthDate');
    const telephone = document.getElementById('studentTelephone');
    if (select) {
      select.addEventListener('change', () => {
        const val = select.value;
        if (val === '') {
          studentIdInput.value = '';
          firstName.value = '';
          lastName.value = '';
          middleName.value = '';
          birthDate.value = '';
          telephone.value = '';
          firstName.readOnly = false;
          lastName.readOnly = false;
          middleName.readOnly = false;
          birthDate.readOnly = false;
          telephone.readOnly = false;
        } else {
          const child = children.find(c => String(c.id) === val);
          if (child) {
            studentIdInput.value = child.id;
            firstName.value = child.firstName || '';
            lastName.value = child.lastName || '';
            middleName.value = child.middleName || '';
            birthDate.value = child.birthDate ? new Date(child.birthDate).toISOString().slice(0,10) : '';
            telephone.value = child.phone || '';
            firstName.readOnly = true;
            lastName.readOnly = true;
            middleName.readOnly = true;
            birthDate.readOnly = true;
            telephone.readOnly = true;
          }
        }
      });
    }
  </script>
</section>
