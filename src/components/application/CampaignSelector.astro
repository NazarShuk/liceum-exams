---
import ProfileDisplay from "@components/ProfileDisplay.svelte";
import type { campaigns, profiles, forms } from "@db/schema";

type Campaign = typeof campaigns.$inferSelect;
type Profile = typeof profiles.$inferSelect;
type Form = typeof forms.$inferSelect;

interface ProfileWithForm extends Profile {
    form: Form | null;
}

interface CampaignWithProfiles extends Campaign {
    profiles: ProfileWithForm[];
}

interface Props {
    availableCampaigns: CampaignWithProfiles[];
    selectedCampaign?: CampaignWithProfiles;
    applicationCounts?: Record<number, number>;
}

const { availableCampaigns, selectedCampaign, applicationCounts = {} } = Astro.props;
---

<section class="flex flex-col gap-5">
    {selectedCampaign ? (
        <>
            <h1>Оберіть профіль</h1>
            <div class="flex flex-col gap-3 list-colors">
                {selectedCampaign.profiles.map((profile: ProfileWithForm) => (
                    <ProfileDisplay
                        profile={profile}
                        href={`/cabinet/application?campaignId=${selectedCampaign.id}&profileId=${profile.id}`}
                        count={applicationCounts[profile.id] ?? 0}
                        client:load
                    />
                ))}
            </div>
        </>
    ) : availableCampaigns.length === 0 ? (
        <>
            <h1>Немає доступних кампаній</h1>
            <p class="opacity-75">Наразі немає вступних кампаній, за якими можна подати заяву.</p>
        </>
    ) : (
        <>
            <h1>Оберіть вступну кампанію</h1>
            <ul class="flex flex-col gap-3 list-colors">
                {availableCampaigns.map((campaign: CampaignWithProfiles) => (
                    <li>
                        <a href={`/cabinet/application?campaignId=${campaign.id}`}>
                            <div class="card">
                                <div class="w-full flex flex-row justify-between items-center">
                                    <h4>{campaign.title}</h4>
                                    <p>{campaign.profiles.length} профілів</p>
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </>
    )}
</section>
