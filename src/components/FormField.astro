---
import {forms} from "@db/schema"
type Schema = typeof forms.$inferSelect["schema"][0];

interface Props {
    field: Schema,
    preview: boolean,
    previewValue: any|undefined
}

const {field, preview, previewValue} = Astro.props

---

<label>
    {field.title}

    <input
        readonly={preview}
        required={!preview}
        value={preview ? previewValue ?? "" : undefined}
        class="lg:w-3/4 w-full"
        name={"form-" + field.slug}
        placeholder={"Ваша відповідь..."}
        type={field.type}
    >
</label>
