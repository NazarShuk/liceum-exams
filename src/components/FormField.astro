---
import { forms } from "@db/schema";
import { useTranslations } from "@i18n/index";
type Schema = (typeof forms.$inferSelect)["schema"][0];

interface Props {
    field: Schema;
    previewValue: unknown | undefined;
}

const { field, previewValue } = Astro.props;
const t = useTranslations(Astro.locals.locale);

const name = "form-" + field.slug;
const options = field.options ?? [];

const selectedValues = (Array.isArray(previewValue) ? previewValue : previewValue == null ? [] : [previewValue]).map(
    String,
);
const textValue = Array.isArray(previewValue) ? previewValue.join(", ") : String(previewValue ?? "");
const fileKey =
    typeof previewValue === "object" &&
    previewValue !== null &&
    "key" in previewValue &&
    typeof previewValue.key === "string"
        ? previewValue.key
        : null;
const fileHref = fileKey ? `/file?key=${encodeURIComponent(fileKey)}` : null;
---

<div class="card mb-5">
    <h4 class="mb-5">{field.title}</h4>
    {field.type === "file" && fileHref ? (
        <a class="btn-default" target="_blank" href={fileHref}>
            {t("common.downloadFile")}
        </a>
    ) : field.type === "select" || field.type === "multiselect" ? (
        <fieldset class="flex flex-col gap-2 lg:w-3/4 w-full" disabled>
            {options.map((option) => (
                <label class="flex items-center gap-2">
                    <input
                        type={field.type === "multiselect" ? "checkbox" : "radio"}
                        name={name}
                        value={option}
                        checked={selectedValues.includes(option)}
                        disabled
                    />
                    <span>{option}</span>
                </label>
            ))}
        </fieldset>
    ) : (
        <input
            readonly
            value={textValue}
            class="lg:w-3/4 w-full"
            name={name}
            placeholder={t("application.answerPlaceholder")}
            type={field.type}
            minlength={field.type === "text" && field.min > 0 ? field.min : undefined}
            maxlength={field.type === "text" && field.max > 0 ? field.max : undefined}
            min={field.type === "number" && field.min > 0 ? field.min : undefined}
            max={field.type === "number" && field.max > 0 ? field.max : undefined}
            pattern={field.type === "text" && field.regex ? field.regex : undefined}
        />
    )}

    {!field.required && <p class="opacity-75 mt-5">{t("application.optionalMark")}</p>}
</div>
