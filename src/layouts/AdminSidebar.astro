---
const links = [
    {
        name: "Заяви",
        href: "/admin/applications"
    },
    {
        name: "Кампанії",
        href: "/admin/campaigns"
    },
    {
        name: "Профілі",
        href: "/admin/profiles"
    },
    {
        name: "Форми",
        href: "/admin/forms"
    },
    {
        name: "Назад до кабінету",
        href: "/cabinet"
    }
]

---
<ul class="border-r h-screen sticky top-0">
    {links.map(link => (
        <li>
            <a class={`${Astro.url.pathname.startsWith(link.href) ? "border-b-2" : ""}`} href={link.href}>{link.name}</a>
        </li>
    ))}
</ul>
