---
const links = [
    {
        name: "Заяви",
        href: "/admin/applications"
    },
    {
        name: "Кампанії",
        href: "/admin/campaigns"
    },
    {
        name: "Профілі",
        href: "/admin/profiles"
    },
    {
        name: "Форми",
        href: "/admin/forms"
    },
    {
        name: "Назад до кабінету",
        href: "/cabinet"
    }
]

---
<ul class="w-1/2 ml-auto border-r h-full">
    <li class="mb-5 ">
        <h1>Адмін</h1>
    </li>
    {links.map(link => (
        <li>
            <a class={`${Astro.url.pathname.endsWith(link.href) ? "border-b-2" : ""}`} href={link.href}>{link.name}</a>
        </li>
    ))}
</ul>