---
import { getDrizzle } from "@db/drizzle";
import {format} from "date-fns"
import { uk } from "date-fns/locale";

const {id} = Astro.props;

const db = getDrizzle()
const result = await db.query.applications.findFirst({
    with: {user: true, student: true},
    where: {id: id}
})
if (!result) return


---

<li class="card mb-5">
    <a href=`/cabinet/application?preview=${result.id}`>
        <h4>{result.student?.firstName} {result.student?.lastName}</h4>
        <p class="opacity-50">{result.createdAt ? format(new Date(result.createdAt), "PPP", {locale: uk}) : ''}</p>
    </a>
</li>