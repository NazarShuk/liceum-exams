---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import Sidebar from "./Sidebar.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import LiceumLogoVstup from "../assets/LiceumLogoVstup.svg";

interface Props {
    className?: string;
    title?: string;
    noPadding?: boolean;
}

const { className, title, noPadding } = Astro.props;
const showChrome = Astro.url.pathname !== "/";
const icons = [
    "more_vert",
    "draft",
    "add_circle",
    "edit",
    "table",
    "groups",
    "group_add",
    "group_remove",
    "manage_accounts",
    "campaign",
    "event",
    "account_circle",
    "login",
    "push_pin",
    "visibility",
    "menu",
    "close",
    "call",
    "mail",
    "location_on",
    "share",
    "content_copy",
    "delete",
    "export_notes",
    "check_circle",
    "info",
    "edit_note",
    "arrow_upward",
    "arrow_downward",
    "light_mode",
    "dark_mode",
];
---

<!doctype html>
<html lang="uk" transition:animate="none">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="/favicon.svg" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="Вступ до ліцею" />
        <Font cssVariable="--font-e-ukraine" />
        <meta name="generator" content={Astro.generator} />
        <script is:inline>
            (() => {
                try {
                    const saved = localStorage.getItem("theme");
                    const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
                    document.documentElement.classList.toggle("dark", dark);
                } catch {}
            })();
        </script>
        <link
            href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&icon_names=${icons.join(",")}&display=block`}
            rel="stylesheet"
        />
        {Astro.url.pathname === "/" && (
            <meta name="google-site-verification" content="opb_3F3I2jsNzVlDOvDSS-Wr998r8GadJUsvkKYCME8" />
        )}
        <ClientRouter />
        <title>{title ? title + " - " : ""} Вступ до ліцею</title>
    </head>
    <body class="flex min-h-screen flex-col">
        {showChrome && <ThemeToggle class="fixed right-2 top-2 z-60" />}
        {showChrome && (
            <header class="sticky top-0 z-40 w-full bg-white">
                <nav class="flex h-16 w-full items-center gap-4 border-b border-diia-bright-grey px-4 py-1 max-lg:pl-16">
                    <a class="h-full" href="/">
                        <LiceumLogoVstup class={"brand-logo h-full w-full"} />
                    </a>
                </nav>
            </header>
        )}
        <div class="flex w-full flex-1">
            {showChrome && <Sidebar />}

            <div class="flex min-w-0 flex-1 flex-col">
                <main class={`w-full flex-1 ${!noPadding ? "p-1" : ""} ${className}`}>
                    <slot />
                </main>
                {Astro.slots.has("footer") && (
                    <footer class="border-t border-diia-bright-grey px-5 py-8 sm:px-8 lg:px-12">
                        <slot name="footer" />
                    </footer>
                )}
            </div>
        </div>
    </body>
</html>

<script>
    const root = document.documentElement;

    if (import.meta.env.PROD && "serviceWorker" in navigator) {
        // "none" makes the browser bypass the HTTP cache when checking for a new
        // service worker, so a deploy is picked up as soon as a page loads.
        navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" }).catch(() => {});
    }

    function setTheme(dark: boolean) {
        root.classList.toggle("dark", dark);
        try {
            localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
    }

    if (!document.documentElement.dataset.themeReady) {
        document.documentElement.dataset.themeReady = "1";
        document.addEventListener("click", (event) => {
            if ((event.target as Element | null)?.closest("#theme-toggle")) {
                setTheme(!root.classList.contains("dark"));
            }
        });
    }

    document.addEventListener("astro:after-swap", () => {
        try {
            const saved = localStorage.getItem("theme");
            const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
            root.classList.toggle("dark", dark);
        } catch {}
    });

    document.addEventListener("astro:before-preparation", () => {
        document.documentElement.classList.add("is-navigating");
    });
    document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.remove("is-navigating");
    });
</script>
