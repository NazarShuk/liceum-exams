---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props{
	className?: string,
	title?: string
}

const {className, title} = Astro.props;
---

<!doctype html>
<html lang="ua" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-e-ukraine" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title ? title + " | " : ""} Вступний кабінет Наукового Ліцею</title>
  </head>
  <body>
    <main class="w-full flex flex-row justify-center">
      <section class="h-screen p-1 w-1/4 lg:block hidden">
        <slot name="left-side" />
      </section>
      <section class={`lg:w-2/4 w-full h-screen p-1 ${className}`}>
        <slot />
        <footer class="h-32">
        	<slot name="footer" />
        </footer>
      </section>
      <section class="h-screen p-1 w-1/4 lg:block hidden">
        <slot name="right-side" />
      </section>
    </main>
  </body>
</html>

<script>
  document.addEventListener('astro:before-preparation', () => {
    document.documentElement.classList.add('is-navigating');
  });
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.remove('is-navigating');
  });
</script>
