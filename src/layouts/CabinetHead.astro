---
const links = [
    {
        name: "Адмін Панель",
        href: "/admin",
        visible: Astro.locals.user.role === "admin"
    },
    {
        name: "Кабінет",
        href: "/cabinet",
        visible: true
    },
    {
        name: "Аккаунт",
        href: "/cabinet/account",
        visible: true
    }
]
---

<h1 class="py-8">Привіт, {Astro.locals.user.firstName}</h1>

<div class="w-full flex flex-row gap-12 py-3">
    {links.filter(link=> link.visible).map(link => (
        <a class={`cursor-pointer ${Astro.url.pathname === link.href ? "border-b-2" : ""}`} href={link.href}>{link.name}</a>
    ))}
</div>
