---
const links = [
    {
        name: "Кабінет",
        href: "/cabinet",
    },
    {
        name: "Новини",
        href: "/cabinet/news"
    },
    {
        name: "Аккаунт",
        href: "/cabinet/account"
    }
]
---

<h1 class="py-8">Привіт, {Astro.locals.user.firstName}</h1>

<div class="w-full flex flex-row gap-12 py-3">
    {links.map(link => (
        <a class={`cursor-pointer ${Astro.url.pathname.endsWith(link.href) ? "border-b-2" : ""}`} href={link.href}>{link.name}</a>
    ))}
</div>