{
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "printWidth": 120,
    "trailingComma": "all",
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
    "overrides": [
        {
            "files": "*.astro",
            "options": { "parser": "astro" }
        },
        {
            "files": "*.svelte",
            "options": { "parser": "svelte" }
        }
    ]
}
