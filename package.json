    "db:studio": "drizzle-kit studio --config=drizzle.config.local.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "jose": "^6.2.12",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
